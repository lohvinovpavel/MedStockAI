# Local development settings. Copy to `.env`; that file is gitignored.
# Every name here is read by shared/medstock_shared/config.py — pydantic maps
# each Settings field to the upper-case env var of the same name, so a variable
# spelled any other way is silently ignored and the field keeps its default.

# --- database ---------------------------------------------------------------
# The only one most services need. Compose and k8s inject their own.
DATABASE_URL=postgresql+psycopg://medstock:medstock@localhost:5432/medstock

# --- auth -------------------------------------------------------------------
# `auth` mints tokens and is the only service that holds the private key; the
# others verify locally with the public one (docs/auth-spec.md §4).
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ALGORITHM=RS256
JWT_TTL_HOURS=8

# --- Gemini -----------------------------------------------------------------
# **GEMINI_API_KEY, not GOOGLE_API_KEY.** The google-genai SDK honours both, but
# ai.py passes settings.gemini_api_key explicitly, so only this spelling reaches
# the client — a key under the other name leaves it empty and every ask_ai()
# call fails. deploy/k8s/*.yaml all set GEMINI_API_KEY; keep local dev matching.
#
# Needed by: analogue (UC-5 ranking), prediction, and ingest's offline prognosis
# CronJob. Everything else runs fine without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
