# Copy to .env.local (gitignored) and restart `next dev` to pick it up.

# Lets /login sign in with a role and no password, storing the session
# client-side only (localStorage) instead of calling services/auth. For
# running the web/ frontend alone, with no backend and no Postgres up.
#
# Baked in at build time (NEXT_PUBLIC_) so it can't be toggled at runtime —
# never set this for a real deployment.
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=true
